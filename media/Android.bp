prebuilt_etc {
    name: "alsa-ucm-conf-files-Nintendo_Switch",
    vendor: true,
    relative_install_path: "alsa/ucm2/Nintendo/Switch",
    srcs: [
        "HiFi.conf",
        "Nintendo-Switch.conf",
    ],
}

install_symlink {
    name: "alsa-ucm-conf-link-conf.d_tegra-ape_switch-ape-rt5640.conf",
    vendor: true,
    installed_location: "etc/alsa/ucm2/conf.d/tegra-ape/switch-ape-rt5640.conf",
    symlink_target: "../../Nintendo/Switch/Nintendo-Switch.conf",
}

phony {
    name: "alsa-ucm-conf-card-nx",
    required: [
        "alsa-ucm-conf-base",
        "alsa-ucm-conf-files-Nintendo_Switch",
        "alsa-ucm-conf-files-codecs_hda",
        "alsa-ucm-conf-files-codecs_rt5640",
        "alsa-ucm-conf-files-lib",
        "alsa-ucm-conf-link-conf.d_tegra-ape_switch-ape-rt5640.conf",
    ],
}
